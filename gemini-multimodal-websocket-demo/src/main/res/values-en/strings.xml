    <!-- Agents Tab -->
    <string name="agents_control_title">Voice Control Agent</string>
    <string name="agents_control_switch">Enable control agent</string>
    <string name="agents_control_on_desc">✅ ENABLED: Agent listens for voice commands (\"mute\", \"disconnect\", \"switch to...\") and performs system actions in the background.</string>
    <string name="agents_control_off_desc">❌ DISABLED: All voice commands are passed to the main Gemini Live agent.</string>
    <string name="agents_how_works_title">ℹ️ How the control agent works:</string>
    <string name="agents_how_works_item1">Runs parallel to the main Gemini Live agent (doesn\'t block conversation)</string>
    <string name="agents_how_works_item2">Recognizes commands: \"mute\", \"disconnect\", \"switch to [conversation name]\"</string>
    <string name="agents_how_works_item3">In case of doubt, passes control back to the main agent (fail-safe)</string>
    <string name="agents_how_works_item4">Supports Polish and English commands</string>
    <string name="agents_control_active">Control agent is active</string>
    <string name="agents_reasoning_title">Reasoning Agent</string>
    <string name="agents_reasoning_switch">Enable Reasoning Agent</string>
    <string name="agents_reasoning_on_desc">✅ ENABLED: Reasoning agent runs in the background, performing deep analyses, searches, and generating reports.</string>
    <string name="agents_reasoning_off_desc">❌ DISABLED: All analytical tasks are passed to the main Gemini Live agent.</string>
    <string name="agents_reasoning_how_works_title">ℹ️ How the Reasoning Agent works:</string>
    <string name="agents_reasoning_how_works_item1">Runs asynchronously in the background (doesn\'t block conversation)</string>
    <string name="agents_reasoning_how_works_item2">Performs deep searches via Perplexity with citations</string>
    <string name="agents_reasoning_how_works_item3">Saves notes, copies to clipboard, sends to Telegram</string>
    <string name="agents_reasoning_how_works_item4">Generates post-session reports based on detected topics</string>
    <string name="agents_reasoning_how_works_item5">Uses advanced models (Gemini, DeepSeek) via Gemini API or OpenRouter</string>
    <string name="agents_reasoning_model_label">Reasoning model</string>
    <string name="agents_reasoning_model_desc">Model used for deep analysis and reasoning. DeepSeek V3.2 is recommended for high quality and low cost.</string>
    <string name="agents_whisperer_label">Whisperer Mode (auto-start)</string>
    <string name="agents_whisperer_on_desc">✅ ENABLED: Gemini Live automatically starts Reasoning Agent when it detects lack of knowledge or need for deeper analysis.</string>
    <string name="agents_whisperer_off_desc">❌ DISABLED: Reasoning Agent only starts on explicit user command.</string>
    <string name="agents_whisperer_how_works_title">ℹ️ Whisperer Mode:</string>
    <string name="agents_whisperer_how_works_item1">Gemini Live detects when it doesn\'t have enough knowledge</string>
    <string name="agents_whisperer_how_works_item2">Automatically starts Reasoning Agent in the background (without notifying user)</string>
    <string name="agents_whisperer_how_works_item3">Continues conversation naturally, \"buying time\" for analysis</string>
    <string name="agents_whisperer_how_works_item4">When result is ready, injects knowledge into the conversation</string>
    <string name="agents_reasoning_active">Reasoning Agent is active</string>
    <string name="agents_api_keys_required_title">⚠️ Required API Keys:</string>
    <string name="agents_api_keys_required_item1">OpenRouter API - access to reasoning models (DeepSeek, Claude)</string>
    <string name="agents_api_keys_required_item2">Perplexity API - real-time search with citations</string>
    <string name="agents_api_keys_required_footer">Configure keys in the \"Keys and accounts\" tab</string>
    <string name="agents_librechat_title">LibreChat</string>
    <string name="agents_librechat_ocr_label">OCR Mode (Text Recognition)</string>
    <string name="agents_librechat_ocr_on_desc">✅ ENABLED: Photos will be processed via OCR (text), not directly by the vision model.</string>
    <string name="agents_librechat_ocr_off_desc">❌ DISABLED: Photos are sent directly to the model (Vision mode).</string>
    <string name="agents_librechat_ocr_how_works_title">ℹ️ About OCR Mode:</string>
    <string name="agents_librechat_ocr_how_works_item1">Uses server-side OCR module (e.g., Mistral OCR) to extract text</string>
    <string name="agents_librechat_ocr_how_works_item2">Model receives clean text instead of image pixels</string>
    <string name="agents_librechat_ocr_how_works_item3">Useful in low light or very small print</string>

